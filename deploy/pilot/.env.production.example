EVIDA_PUBLIC_HOST=evida-pilot.example.no
EVIDA_BUILD_ID=replace-with-release-commit
EVIDA_TLS_CERT_DIR=/srv/evida/tls
EVIDA_ENCRYPTED_DATA_DIR=/srv/evida-encrypted/documents
EVIDA_ENCRYPTED_POSTGRES_DIR=/srv/evida-encrypted/postgres
EVIDA_STORAGE_ENCRYPTION_ATTESTED=true
EVIDA_OIDC_ISSUER=https://idp.example.no/realms/evida
EVIDA_OIDC_CLIENT_ID=evida-pilot
EVIDA_OIDC_CLIENT_SECRET=replace-via-secrets-manager
EVIDA_OAUTH_COOKIE_SECRET=replace-with-32-byte-base64-secret
EVIDA_ALLOWED_EMAIL_DOMAIN=example.no
EVIDA_MFA_ACCEPTED_AMR=mfa,otp,hwk
EVIDA_MFA_ACCEPTED_ACR=
EVIDA_ALLOWED_ROLES=OWNER,ADMIN,TENANT_ADMIN,LAWYER,CASE_WORKER,VIEWER,AUDITOR,SECURITY_ADMIN
EVIDA_DATABASE_PASSWORD=replace-via-secrets-manager
